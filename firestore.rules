rules_version='2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isOwnerByEmail(userEmail) {
      return isAuthenticated() && request.auth.token.email == userEmail;
    }

    function isSiteAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'mangawatch.off@gmail.com' ||
        request.auth.token.email == 'mathieubroyer190508@gmail.com'
      );
    }

    function isCommunityModerator() {
      return isSiteAdmin();
    }

    function authEmail() {
      return request.auth.token.email;
    }

    function emailsMatch(a, b) {
      return a is string && b is string && a.lower() == b.lower();
    }

    function isCommunityMessageOwner(userEmail) {
      return isAuthenticated() && emailsMatch(userEmail, authEmail());
    }

    function isValidPollDurationFields() {
      return (
        !('duration_minutes' in request.resource.data) ||
        (request.resource.data.duration_minutes is int &&
         request.resource.data.duration_minutes >= 0 &&
         request.resource.data.duration_minutes <= 10080)
      ) && (
        !('closes_at' in request.resource.data) ||
        request.resource.data.closes_at == null ||
        (request.resource.data.closes_at is timestamp &&
         request.resource.data.closes_at > request.time &&
         request.resource.data.closes_at <= request.time + duration.value(7, 'd'))
      );
    }

    function communityPollData(channel, messageId) {
      return get(/databases/$(database)/documents/community_chat/$(channel)/messages/$(messageId)).data;
    }

    function isCommunityPollOpen(channel, messageId) {
      let poll = communityPollData(channel, messageId);
      return poll.type == 'poll' && (
        !('closes_at' in poll) ||
        poll.closes_at == null ||
        request.time < poll.closes_at
      );
    }
    
    // Forum Topics - Sujets du forum
    match /forum_topics/{topicId} {
      allow read: if true; // Lecture publique
      allow create: if isAuthenticated(); // Création si connecté
      allow update, delete: if isAuthenticated() && 
        (resource.data.user_id == request.auth.uid || 
         request.auth.token.admin == true); // Modification par le propriétaire ou admin
    }
    
    // Forum Replies - Réponses du forum
    match /forum_replies/{replyId} {
      allow read: if true; // Lecture publique
      allow create: if isAuthenticated(); // Création si connecté
      allow update, delete: if isAuthenticated() && 
        (resource.data.user_id == request.auth.uid || 
         request.auth.token.admin == true); // Modification par le propriétaire ou admin
    }
    
    // Messages - Messages globaux et privés
    match /messages/{messageId} {
      allow read: if isAuthenticated() && 
        (resource.data.recipient_email == null || // Message global
         resource.data.recipient_email == request.auth.token.email || // Message pour l'utilisateur
         resource.data.created_by == request.auth.token.email); // Message créé par l'utilisateur
      allow create: if isAuthenticated(); // Création si connecté
      allow update: if isAuthenticated() && 
        resource.data.recipient_email == request.auth.token.email; // Mise à jour par le destinataire
      allow delete: if isAuthenticated() && 
        (resource.data.created_by == request.auth.token.email || 
         request.auth.token.admin == true); // Suppression par le créateur ou admin
    }
    
    // User Content Notes - Notes utilisateur (étoiles, genres, etc.)
    match /user_content_notes/{noteId} {
      allow read: if true; // Lecture publique - tous peuvent voir les notes des autres
      allow create, update, delete: if isAuthenticated() && 
        (request.resource.data.user_email == request.auth.token.email || 
         resource.data.user_email == request.auth.token.email); // Modification uniquement par le propriétaire
    }
    
    // User Top 10 - Top 10 utilisateur
    match /user_top10/{itemId} {
      allow read: if true; // Lecture publique - tous peuvent voir le top 10 des autres
      allow create, update, delete: if isAuthenticated() && 
        (request.resource.data.user_email == request.auth.token.email || 
         resource.data.user_email == request.auth.token.email); // Modification uniquement par le propriétaire
    }
    
    // User Profiles - Profils utilisateur (optionnel)
    match /user_profiles/{userId} {
      allow read: if true; // Lecture publique des profils
      // Création : le userId (qui est l'email) doit correspondre à l'email de l'utilisateur authentifié
      // OU l'email dans les données doit correspondre
      allow create: if isAuthenticated() && 
        (userId == request.auth.token.email || 
         request.resource.data.email == request.auth.token.email);
      // Mise à jour : le userId (qui est l'email) doit correspondre à l'email de l'utilisateur authentifié
      // OU l'utilisateur est admin (pour permettre la modification du champ verified)
      // OU l'utilisateur est authentifié et modifie uniquement le champ verified (pour permettre la certification par l'admin)
      allow update: if isAuthenticated() && 
        (userId == request.auth.token.email ||
         request.auth.token.admin == true ||
         // Permettre la modification du champ verified même si ce n'est pas le propriétaire
         // (pour permettre à l'admin de certifier des utilisateurs)
         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified', 'updated_at'])));
      // Suppression : uniquement par le propriétaire
      allow delete: if isAuthenticated() && 
        (userId == request.auth.token.email ||
         (resource != null && resource.data.email == request.auth.token.email));
    }
    
    // User List - Collection utilisateur (liste de mangas/animes)
    match /user_list/{itemId} {
      allow read: if true; // Lecture publique - tous peuvent voir les collections des autres
      allow create, update, delete: if isAuthenticated() && 
        (request.resource.data.user_email == request.auth.token.email || 
         resource.data.user_email == request.auth.token.email); // Modification uniquement par le propriétaire
    }
    
    // Boutique stats - compteurs codes promo / clics site partenaires
    match /boutique_stats/{storeId} {
      allow read: if true;
      allow create, update: if true;
    }

    // Vote du jour (accueil) — mêmes 3 œuvres pour tous les visiteurs
    match /site_daily_vote/{dayId} {
      allow read: if true;
      allow create, update: if true;
    }

    // Sondage nouveautés site (accueil) — compteurs agrégés
    match /feature_poll/{docId} {
      allow read: if true;
      allow create, update: if true;
    }

    // Propositions du sondage (soumises par les utilisateurs)
    match /feature_poll_proposals/{proposalId} {
      allow read: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if true;
    }

    // Notes de profil utilisateur
    match /profile_rating_votes/{voteId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (
        request.resource.data.voter_email == request.auth.token.email ||
        (isSiteAdmin() && request.resource.data.admin_vote == true)
      );
      allow delete: if false;
    }

    match /profile_rating_stats/{profileId} {
      allow read: if true;
      allow create, update: if isAuthenticated() || (
        request.resource.data.admin_adjusted == true &&
        request.resource.data.profile_email == profileId &&
        request.resource.data.count is int &&
        request.resource.data.count >= 0 &&
        request.resource.data.sum is number &&
        request.resource.data.average is number &&
        request.resource.data.average >= 0 &&
        request.resource.data.average <= 10
      );
      allow delete: if false;
    }

    // Un document par email — votes up/down par proposition (mise à jour autorisée)
    match /feature_poll_voters/{voterId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Signalements utilisateur (profil public)
    match /user_reports/{reportId} {
      allow read: if isAuthenticated() && (
        isSiteAdmin() ||
        resource.data.reported_by == request.auth.token.email
      );
      allow create: if isAuthenticated() &&
        request.resource.data.reported_by == request.auth.token.email &&
        request.resource.data.reported_user is string &&
        request.resource.data.reported_by != request.resource.data.reported_user;
      allow update: if false;
      allow delete: if isAuthenticated() && (
        isSiteAdmin() ||
        resource.data.reported_by == request.auth.token.email
      );
    }

    // Support Tickets - Tickets d'aide (conversation user + admin, fermeture par l'un ou l'autre)
    match /support_tickets/{ticketId} {
      allow read: if isAuthenticated() && (
        request.auth.token.admin == true ||
        resource.data.user_email == request.auth.token.email
      );
      allow create: if true; // Tout le monde peut envoyer un ticket
      allow update: if isAuthenticated() && (
        request.auth.token.admin == true ||
        resource.data.user_email == request.auth.token.email
      );
      allow delete: if isAuthenticated() && request.auth.token.admin == true;
    }

    // Salon communautaire — messages par canal
    match /community_chat/{channel}/messages/{messageId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        emailsMatch(request.resource.data.user_email, authEmail()) && (
          (
            (!('type' in request.resource.data) || request.resource.data.type == 'message') &&
            request.resource.data.text is string &&
            request.resource.data.text.size() > 0 &&
            request.resource.data.text.size() <= 2000
          ) ||
          (
            request.resource.data.type == 'poll' &&
            request.resource.data.question is string &&
            request.resource.data.question.size() >= 3 &&
            request.resource.data.question.size() <= 300 &&
            request.resource.data.options is list &&
            request.resource.data.options.size() >= 2 &&
            request.resource.data.options.size() <= 6 &&
            isValidPollDurationFields()
          )
        );
      allow update: if isAuthenticated() && (
        isCommunityModerator() ||
        (resource.data.type != 'poll' &&
         isCommunityMessageOwner(resource.data.user_email) &&
         emailsMatch(request.resource.data.user_email, resource.data.user_email) &&
         request.resource.data.text is string &&
         request.resource.data.text.size() > 0 &&
         request.resource.data.text.size() <= 2000 &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updated_at', 'edited']))
      );
      allow delete: if isAuthenticated() && (
        isCommunityMessageOwner(resource.data.user_email) ||
        isCommunityModerator()
      );

      match /poll_votes/{voterId} {
        allow read: if true;
        allow create, update: if isAuthenticated() &&
          voterId == request.auth.uid &&
          isCommunityPollOpen(channel, messageId) &&
          request.resource.data.option_index is int &&
          request.resource.data.option_index >= 0 &&
          request.resource.data.option_index <= 5 &&
          emailsMatch(request.resource.data.voter_email, authEmail());
        allow delete: if isAuthenticated() && (
          voterId == request.auth.uid ||
          isCommunityModerator() ||
          isCommunityMessageOwner(
            get(/databases/$(database)/documents/community_chat/$(channel)/messages/$(messageId)).data.user_email
          )
        );
      }
    }

    // Salons créés par les utilisateurs (métadonnées)
    match /community_channels/{channelId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        channelId != 'general' &&
        request.resource.data.slug == channelId &&
        emailsMatch(request.resource.data.created_by, authEmail()) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 60 &&
        request.resource.data.builtin == false;
      allow update: if false;
      allow delete: if isAuthenticated() && (
        isCommunityModerator() ||
        emailsMatch(resource.data.created_by, authEmail())
      );
    }

    // Présence salon (en ligne)
    match /community_presence/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && emailsMatch(userId, authEmail());
      allow delete: if isAuthenticated() && emailsMatch(userId, authEmail());
    }
  }
}
