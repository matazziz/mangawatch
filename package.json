{
  "name": "mangawatch",
  "version": "1.0.0",
  "description": "Plateforme de gestion et de notation d'animes et mangas",
  "main": "server.js",
  "scripts": {
    "inject-firebase-key": "node scripts/inject-firebase-api-key.js",
    "start": "node js/server.js",
    "dev": "cross-env NODE_ENV=development nodemon js/server.js",
    "live": "powershell -ExecutionPolicy Bypass -File scripts/dev-live.ps1",
    "live:manga": "powershell -ExecutionPolicy Bypass -File scripts/dev-live.ps1 manga-database",
    "live:users": "powershell -ExecutionPolicy Bypass -File scripts/dev-live.ps1 salon",
    "live:salon": "powershell -ExecutionPolicy Bypass -File scripts/dev-live.ps1 salon",
    "admin": "powershell -ExecutionPolicy Bypass -File scripts/ouvrir-admin.ps1",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "anime",
    "manga",
    "rating",
    "collection",
    "tierlist",
    "forum"
  ],
  "author": "matazziz & bakitary",
  "license": "MIT",
  "dependencies": {
    "@sendgrid/mail": "^7.7.0",
    "nodemailer": "^6.9.1",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "connect-livereload": "^0.6.1",
    "cross-env": "^7.0.3",
    "livereload": "^0.9.3",
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
